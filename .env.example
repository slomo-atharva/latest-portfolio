# Contact form (footer) — required for /api/contact to send mail.
#
# 1. Create a free account at https://resend.com using the same address you
#    want messages delivered to, then create an API key.
# 2. Copy this file to .env.local and fill in the key below.
# 3. Add both variables in Vercel → Project → Settings → Environment Variables.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=you@example.com

# Optional. Defaults to Resend's shared sender, which can only deliver to the
# address that owns the Resend account. Once you verify your own domain in
# Resend you can send from it instead, e.g. "Portfolio <hello@yourdomain.com>".
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Case study NDA gate. Visitors must enter this to read gated sections.
# NOTE: lib/case-access.ts falls back to a default if this is unset, and this
# repo is public — so set a real value in Vercel if the password should not be
# discoverable from the source.
CASE_STUDY_PASSWORD=choose-a-password

# Optional but recommended in production: an independent secret used to sign the
# unlock cookie. Without it the cookie is signed using the password itself.
# CASE_ACCESS_SECRET=some-long-random-string
